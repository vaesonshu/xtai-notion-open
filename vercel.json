{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile && pnpm --filter api prisma:generate && pnpm turbo build --filter=@xtai-notion/editor-core",
  "buildCommand": "pnpm turbo build --filter=web",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/apps/web/api/nest"
    }
  ],
  "functions": {
    "apps/web/api/nest.ts": {
      "includeFiles": "{apps/api/prisma/**,apps/api/src/generated/**}",
      "maxDuration": 30
    }
  }
}
