{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile && pnpm --filter api prisma:generate && pnpm turbo build --filter=@xtai-notion/editor-core",
  "buildCommand": "cd ../.. && pnpm turbo build --filter=web",
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "/api/nest"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/nest"
    }
  ],
  "functions": {
    "api/nest.ts": {
      "includeFiles": "{../api/prisma/**,../api/src/generated/**}",
      "maxDuration": 30
    }
  }
}
