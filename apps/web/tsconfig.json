{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"],
      "@xtai-notion/editor-core": ["../../packages/editor-core/src/index.ts"],
      "@xtai-notion/editor-core/*": ["../../packages/editor-core/src/core/*"],
      "@xtai-notion/editor-react/collaboration/*": [
        "../../packages/editor-react/src/collaboration/*"
      ],
      "@xtai-notion/editor-react": ["../../packages/editor-react/src/index.ts"],
      "@xtai-notion/editor-react/*": [
        "../../packages/editor-react/src/react/*"
      ],
      "@xtai-notion/editor-shadcn": [
        "../../packages/editor-shadcn/src/index.ts"
      ],
      "@xtai-notion/editor-shadcn/*": ["../../packages/editor-shadcn/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
