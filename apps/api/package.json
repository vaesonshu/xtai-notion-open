{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file=.env src/main.ts",
    "dev:local": "tsx watch --conditions=development --env-file=.env --env-file=.env.local src/main.ts",
    "dev:collab": "tsx watch --conditions=development --env-file=.env src/collab-main.ts",
    "dev:collab:local": "tsx watch --conditions=development --env-file=.env --env-file=.env.local src/collab-main.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json && node scripts/fix-dist-imports.mjs",
    "start:collab": "tsx src/collab-main.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate": "prisma migrate deploy",
    "migrate:local": "node scripts/with-env-local.mjs migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:db:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:studio:local": "node scripts/with-env-local.mjs studio"
  },
  "dependencies": {
    "@hocuspocus/server": "4.5.0",
    "@langchain/core": "^1.2.7",
    "@langchain/openai": "^1.5.7",
    "@neondatabase/serverless": "^1.1.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "pg": "^8.16.3",
    "@prisma/client": "^7.9.1",
    "@xtai-notion/editor-core": "workspace:*",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsx": "4.20.3",
    "ws": "^8.21.3",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@hocuspocus/provider": "4.5.0",
    "@nestjs/testing": "11.1.28",
    "@types/express": "^5.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "prisma": "^7.9.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
