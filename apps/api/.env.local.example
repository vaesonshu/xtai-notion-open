# 复制为 .env.local 后配合 pnpm db:local:setup / pnpm dev:local 使用。
# .env.local 会覆盖 .env 中的同名变量，便于在 Neon 与本地库之间切换。
PORT=3100
COLLABORATION_PORT=3101
NODE_ENV=development

# 本地 Docker Postgres（见根目录 docker-compose.yml）
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://xtai:xtai_local_dev@127.0.0.1:5432/xtai_notion

# 可选：与 .env.example 相同
# COS_SECRET_ID=
# COS_SECRET_KEY=
# OPENAI_API_KEY=
