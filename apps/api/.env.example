PORT=3100
COLLABORATION_PORT=3101
NODE_ENV=development
# 生产/Neon 建议使用带 -pooler 的池化连接串并加大超时以应对冷启动。
# Prisma Neon 适配器在 Node 20 需 ws 包（已在 prisma.module 中配置 webSocketConstructor）。
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.us-west-2.aws.neon.tech/DB?sslmode=require&connect_timeout=15&pool_timeout=15
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=examplebucket-1250000000
COS_REGION=ap-guangzhou
# Optional CDN or custom public base URL. Defaults to the COS public object URL.
# Do not include a trailing slash when set.
COS_PUBLIC_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
