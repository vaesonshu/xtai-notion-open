{
  "name": "@xtai-notion/editor-core",
  "version": "0.0.1",
  "private": false,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@hocuspocus/provider": "4.5.0",
    "@hocuspocus/transformer": "4.5.0",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-collaboration": "3.29.2",
    "@tiptap/extension-collaboration-caret": "3.29.2",
    "@tiptap/extension-color": "3.29.2",
    "@tiptap/extension-dropcursor": "3.29.2",
    "@tiptap/extension-link": "3.29.2",
    "@tiptap/extension-mention": "3.29.2",
    "@tiptap/extension-placeholder": "3.29.2",
    "@tiptap/extension-strike": "3.29.2",
    "@tiptap/extension-table": "3.29.2",
    "@tiptap/extension-table-cell": "3.29.2",
    "@tiptap/extension-table-header": "3.29.2",
    "@tiptap/extension-table-row": "3.29.2",
    "@tiptap/extension-text-style": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.4",
    "jsdom": "^30.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./migrate": {
      "types": "./src/core/migrate/index.ts",
      "development": "./src/core/migrate/index.ts",
      "import": "./dist/migrate/index.js",
      "require": "./dist/migrate/index.cjs",
      "default": "./dist/migrate/index.js"
    },
    "./*": "./src/core/*",
    "./server": {
      "types": "./src/server.ts",
      "development": "./src/server.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs",
      "default": "./dist/server.js"
    }
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ]
}
