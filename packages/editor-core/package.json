{
  "name": "@xtai-notion/editor-core",
  "version": "0.0.1",
  "private": false,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@hocuspocus/provider": "4.5.0",
    "@hocuspocus/transformer": "4.5.0",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-collaboration": "3.29.2",
    "@tiptap/extension-collaboration-caret": "3.29.2",
    "@tiptap/extension-color": "3.29.2",
    "@tiptap/extension-dropcursor": "3.29.2",
    "@tiptap/extension-link": "3.29.2",
    "@tiptap/extension-mention": "3.29.2",
    "@tiptap/extension-placeholder": "3.29.2",
    "@tiptap/extension-strike": "3.29.2",
    "@tiptap/extension-table": "3.29.2",
    "@tiptap/extension-table-cell": "3.29.2",
    "@tiptap/extension-table-header": "3.29.2",
    "@tiptap/extension-table-row": "3.29.2",
    "@tiptap/extension-text-style": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.4",
    "jsdom": "^30.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "development": "./src/server.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs",
      "default": "./dist/server.js"
    },
    "./migrate": {
      "types": "./src/core/persistence/migrate/index.ts",
      "development": "./src/core/persistence/migrate/index.ts",
      "import": "./dist/migrate/index.js",
      "require": "./dist/migrate/index.cjs",
      "default": "./dist/migrate/index.js"
    },
    "./block-schema/types": {
      "types": "./src/core/model/types.ts",
      "development": "./src/core/model/types.ts",
      "default": "./src/core/model/types.ts"
    },
    "./block-schema/ids": {
      "types": "./src/core/model/ids.ts",
      "development": "./src/core/model/ids.ts",
      "default": "./src/core/model/ids.ts"
    },
    "./block-schema/documents": {
      "types": "./src/core/model/documents.ts",
      "development": "./src/core/model/documents.ts",
      "default": "./src/core/model/documents.ts"
    },
    "./block-schema/convert": {
      "types": "./src/core/api/conversions/pm-doc.ts",
      "development": "./src/core/api/conversions/pm-doc.ts",
      "default": "./src/core/api/conversions/pm-doc.ts"
    },
    "./block-schema/table-paste": {
      "types": "./src/core/api/clipboard/fromClipboard/tableBlockPaste.ts",
      "development": "./src/core/api/clipboard/fromClipboard/tableBlockPaste.ts",
      "default": "./src/core/api/clipboard/fromClipboard/tableBlockPaste.ts"
    },
    "./block-schema/pm-nodes": {
      "types": "./src/core/schema/pm-nodes.ts",
      "development": "./src/core/schema/pm-nodes.ts",
      "default": "./src/core/schema/pm-nodes.ts"
    },
    "./block-editor": {
      "types": "./src/core/editor/block-editor.ts",
      "development": "./src/core/editor/block-editor.ts",
      "default": "./src/core/editor/block-editor.ts"
    },
    "./slash-commands": {
      "types": "./src/core/features/slash/index.ts",
      "development": "./src/core/features/slash/index.ts",
      "default": "./src/core/features/slash/index.ts"
    },
    "./markdown": {
      "types": "./src/core/markdown/index.ts",
      "development": "./src/core/markdown/index.ts",
      "default": "./src/core/markdown/index.ts"
    },
    "./markdown/detect": {
      "types": "./src/core/api/parsers/markdown/detect.ts",
      "development": "./src/core/api/parsers/markdown/detect.ts",
      "default": "./src/core/api/parsers/markdown/detect.ts"
    },
    "./yjs-document": {
      "types": "./src/core/persistence/yjs-document.ts",
      "development": "./src/core/persistence/yjs-document.ts",
      "default": "./src/core/persistence/yjs-document.ts"
    },
    "./*": "./src/core/*"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ]
}
