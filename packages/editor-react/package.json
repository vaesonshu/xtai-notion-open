{
  "name": "@xtai-notion/editor-react",
  "version": "0.0.1",
  "private": false,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@hocuspocus/provider": "4.5.0",
    "@tiptap/core": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@xtai-notion/editor-core": "workspace:*",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.4",
    "jsdom": "^30.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./collaboration": {
      "import": "./dist/collaboration/index.js",
      "require": "./dist/collaboration/index.cjs",
      "types": "./dist/collaboration/index.d.ts"
    },
    "./collaboration/*": "./src/collaboration/*",
    "./*": "./src/react/*"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ]
}
