{
  "name": "xtai-notion-open",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=api --filter=web --filter=@xtai-notion/codex-bridge",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "check:editor-boundaries": "node scripts/check-editor-boundaries.mjs",
    "db:local:up": "docker compose up -d postgres",
    "db:local:down": "docker compose down",
    "db:local:reset": "docker compose down -v && docker compose up -d postgres && node scripts/wait-for-local-postgres.mjs && pnpm --filter api migrate:local",
    "db:local:setup": "pnpm db:local:up && node scripts/wait-for-local-postgres.mjs && pnpm --filter api migrate:local",
    "dev:local": "pnpm --parallel --filter api dev:local --filter web dev --filter @xtai-notion/codex-bridge dev",
    "codex-bridge": "pnpm --filter @xtai-notion/codex-bridge start"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  }
}
